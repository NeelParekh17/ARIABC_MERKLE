# Global excludes across all subdirectories
*.o
*.obj
*.bc
*.so
*.so.[0-9]
*.so.[0-9].[0-9]
*.so.[0-9].[0-9][0-9]
*.sl
*.sl.[0-9]
*.sl.[0-9].[0-9]
*.sl.[0-9].[0-9][0-9]
*.dylib
*.dll
*.exp
*.a
*.mo
*.pot
objfiles.txt
.deps/
*.gcno
*.gcda
*.gcov
*.gcov.out
lcov*.info
coverage/
coverage-html-stamp
*.vcproj
*.vcxproj
win32ver.rc
*.exe
lib*dll.def
lib*.pc

# Local excludes in root directory
/GNUmakefile
/config.cache
/config.log
/config.status
/pgsql.sln
/pgsql.sln.cache
/Debug/
/Release/
/tmp_install/
/.bench_tmp/
/.Trash-1000/
/.vscode/
/src/.vscode/
/.idea/
*.bcdbtest

# Exclude log, markdown, diff files
*.log
*.md
*.diff

# Native Merkle architecture and acceptance contracts are intentional source.
!NATIVE_MERKLE_IMPLEMENTATION_CHECKLIST.md
!Dynamic_merkle_docs/
!Dynamic_merkle_docs/*.md

# Exclude scripts by default (but allow whitelisting specific files)
/scripts/*

# ...except for all distributed orchestration / benchmark / runbook files.
# This folder is the collaborator-facing entrypoint for the 4-node Raft
# cluster work, so everything in it is intentionally tracked.  The earlier
# whitelist-only model kept churning every time a new script was added.
!/scripts/distributed/
!/scripts/distributed/**

# Python bytecode under the distributed/ folder is still build output.
/scripts/distributed/__pycache__/
/scripts/distributed/.safe_recovery_probe_*.sql

# Paper-style Merkle recovery benchmark source files.
!/scripts/benchmark/
!/scripts/benchmark/recovery/
!/scripts/benchmark/recovery/**
!/scripts/benchmark/recovery/README.md
/scripts/benchmark/recovery/__pycache__/
/scripts/benchmark/recovery/results/

# Reproducible correctness and crash-test infrastructure is source, not local
# scratch.  Keep it visible to normal Git workflows.
!/scripts/test/
!/scripts/test/**
/scripts/test/**/__pycache__/

# Local AI/tooling metadata (do not commit)
/.claude/
/.codex

# CMake build output
/ariabc_pg/build/

# Local analysis, scratch outputs, and accidental pasted command fragments
/docs/
/2026-04-21-154054-analysis_issues.txt
/2026-04-22-053752-important_inf0.txt
/2026-04-22-215511-this-session-is-being-continued-from-a-previous-c.txt
/ACM_arxiv-3.pdf
/BCDB_ARCHITECTURE.md.bak
/codex_output.txt
/analysis.txt
/git_diff_worker.txt
/output.txt
/phase0_probe.py
/phase0_probe_autocommit.py
/phase0_probe_simple.py
/EXC:*
/rc={rc})*

# Local-only analysis, build, and test artifacts
/.safe_phase3_artifact_root
/AI_analysis.txt
/Continual_AI_analysis.txt
/ariabc_pg.zip
/build_err.txt
/claude.txt
/diff.txt
/diff_plan_left.txt
/dump_*.txt
/error.txt
/gpt.txt
/in.txt
/test.out
/src/backend.zip
/src/bin/bcsql/bcsql
/src/test/regress/regression.diffs
/src/test/regress/regression.out

/scripts/distributed/det-block-parallel.txt
/scripts/distributed/good_run.txt
/scripts/distributed/latest_run.txt
/scripts/distributed/single_node_good_run.txt
/scripts/distributed/output*.txt
/scripts/distributed/*.log
/scripts/distributed/recovery_artifacts/
/scripts/benchmark/recovery/fetched/
/scripts/benchmark/recovery/results/scratch_*/
/scripts/benchmark/recovery/results/*.copybin

# Merkle recovery benchmark artifacts
scripts/benchmark/recovery/fetched/
scripts/benchmark/recovery/results/
**/__pycache__/
*.py[cod]
*.pyo

__pycache__/
*.py[cod]
