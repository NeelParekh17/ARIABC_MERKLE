# Global excludes across all subdirectories
*.o
*.obj
*.bc
*.so
*.so.[0-9]
*.so.[0-9].[0-9]
*.so.[0-9].[0-9][0-9]
*.sl
*.sl.[0-9]
*.sl.[0-9].[0-9]
*.sl.[0-9].[0-9][0-9]
*.dylib
*.dll
*.exp
*.a
*.mo
*.pot
objfiles.txt
.deps/
*.gcno
*.gcda
*.gcov
*.gcov.out
lcov*.info
coverage/
coverage-html-stamp
*.vcproj
*.vcxproj
win32ver.rc
*.exe
lib*dll.def
lib*.pc

# Local excludes in root directory
/GNUmakefile
/config.cache
/config.log
/config.status
/pgsql.sln
/pgsql.sln.cache
/Debug/
/Release/
/tmp_install/
/.bench_tmp/
/.Trash-1000/
/.vscode/
/src/.vscode/
/.idea/
*.bcdbtest

# Exclude log, markdown, diff files
*.log
*.md
*.diff

# Exclude scripts by default (but allow whitelisting specific files)
/scripts/*

# ...except for a small set of distributed orchestration scripts
!/scripts/distributed/

# Ignore everything under scripts/distributed/ by default...
/scripts/distributed/*

# ...but track these specific entrypoints
!/scripts/distributed/ensure_rdkafka.sh
!/scripts/distributed/ensure_custom_install_from_repo.sh
!/scripts/distributed/run_4node_raft_cluster.sh

# Local AI/tooling metadata (do not commit)
/.claude/
/.codex
